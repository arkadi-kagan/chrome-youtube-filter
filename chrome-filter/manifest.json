{
  "manifest_version": 3,
  "name": "Chrome Youtube Filter",
  "version": "1.0",
  "description": "Filter Youtube content",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": ["scripting", "activeTab"],
  "content_scripts": [
    {
      "js": [
        "scripts/words.js",
        "scripts/base.js",
      	"scripts/youtube.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    },
    {
      "js": [
        "scripts/words.js",
        "scripts/base.js",
      	"scripts/google.js"
      ],
      "matches": [
        "https://www.google.com/*"
      ]
    },
    {
      "js": [
        "scripts/not_allowed.js"
      ],
      "matches": [
        "https://www.vk.com/*",
        "https://m.vk.com/*",
        "https://vk.com/*",
        "https://www.ok.ru/*",
        "https://m.ok.ru/*",
        "https://ok.ru/*",
        "https://www.pornhub.com/*",
        "https://m.pornhub.com/*",
        "https://pornhub.com/*",
        "https://www.xvideos.com/*",
        "https://m.xvideos.com/*",
        "https://xvideos.com/*",
        "https://www.xnxx.com/*",
        "https://m.xnxx.com/*",
        "https://xnxx.com/*"
      ]
    }
  ]
}

